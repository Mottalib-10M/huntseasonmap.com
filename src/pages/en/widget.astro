---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/season-checker/" title="Hunting season checker by state" width="100%" height="1000" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the hunting season checker: open or closed by state" description="Clubs, outfitters, ranges and outdoor stores can embed the hunting season checker, with the 2026-27 deer dates of 24 states, turkey of 12 and duck of 6, in one iframe line." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the checker', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the checker' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the hunting season checker</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. When the agency dates are reread, the embedded checker follows.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Terms: keep the credit line under the checker visible and do not alter the frame. The frame sets no cookie and sends us nothing about your readers. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    <h2>Hunting season checker</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/season-checker/" title="Hunting season checker by state" width="100%" height="1000" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
